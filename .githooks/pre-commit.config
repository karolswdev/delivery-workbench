# Delivery Workbench self-hosting config (project-owned; update.sh never
# touches this file). See pmo-roadmap/templates/PMO-CONTRACT.md §Extending.

# Work logging is on for this repo (WLA-6-01 dogfood decision, 2026-07-02).
# Entries land in the framework default ~/.work/log so hooks (which read
# this file) and dw/work-log-read (which read the environment or default)
# agree without per-shell setup.
PMO_WORK_LOG_ENABLED=1

# This repo hosts exactly one roadmap project; pin the slug so work-log
# entries carry "project: work-log-automation" and dw's trace correlation
# matches them (the auto-inference would fall back to the repo basename
# because the roadmap lives under pmo-roadmap/pm/roadmap, not pm/roadmap).
PMO_WORK_LOG_PROJECT_SLUG="work-log-automation"
