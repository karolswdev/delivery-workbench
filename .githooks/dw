def command_story_create(args: argparse.Namespace) -> int:
    project = get_project(args.root, args.project)
    phase = get_phase(project, args.phase)
    existing = []
    for story in phase.path.glob("story-*.md"):
        m = STORY_RE.match(story.name)
        if m:
            existing.append(int(m.group(1)))
    number = max(existing, default=0) + 1
    slug = args.slug or slugify(args.title)
    story_file = phase.path / f"story-{number:02d}-{slug}.md"
    ensure_under(story_file, roadmap_dir(args.root))
    if story_file.exists():
        die(f"story file already exists: {story_file}")
    story_id = f"{project.prefix}-{phase.number}-{number:02d}"
    row = f"| {story_id} | {args.title} | {args.status} | [{story_file.stem}](./{story_file.name}) | - |"
    status_file = phase.path / "current-phase-status.md"
    write_changes(
        args.root,
        {
            story_file: render_story_template(project, phase, number, args.title, args.status),
            status_file: replace_story_table_content(status_file, row),
        },
    )
    print(story_file.relative_to(args.root))
    return 0


