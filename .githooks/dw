def command_phase_close(args: argparse.Namespace) -> int:
    status = args.status.strip().lower()
    project = get_project(args.root, args.project)
    phase = get_phase(project, args.phase)
    rows = parse_story_rows(phase.path / "current-phase-status.md")
    open_rows = [row for row in rows if row.status not in DONE_STATUSES]
    if open_rows and not args.force:
        ids = ", ".join(row.story_id for row in open_rows)
        die(f"refusing to close phase with non-done stories: {ids}")
    summary_path = phase.path / "final-summary.md"
    ensure_under(summary_path, roadmap_dir(args.root))
    if summary_path.exists() and not args.force:
        die(f"final summary already exists; pass --force to replace: {rel(summary_path, args.root)}")
    summary_body = read_body_arg(args.summary, args.from_file).strip()
    if not summary_body:
        summary_body = "Phase closed by `dw phase close`; see story evidence files for proof."
    readme = project.path / "README.md"
    write_changes(
        args.root,
        {
            summary_path: render_final_summary(phase, summary_body),
            readme: update_phase_index_status_content(readme, phase.number, status),
        },
    )
    print(rel(summary_path, args.root))
    return 0


