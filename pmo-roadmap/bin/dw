    )
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print(
            f"{result['run_id']}\t{result['state']}\t"
            f"ticks={result['ticks']}\tprogressed={result['progressed_ticks']}"
        )
    return 0


